package com.skillforge.backend;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.patch;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import java.nio.charset.StandardCharsets;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.MvcResult;
import org.springframework.transaction.annotation.Transactional;

import com.skillforge.backend.repository.UserRepository;

@SpringBootTest
@AutoConfigureMockMvc
@ActiveProfiles("test")
@Transactional
class SkillForgeApplicationTests {

    @Autowired
    private MockMvc mockMvc;

    @Autowired
    private ObjectMapper objectMapper;

    @Autowired
    private UserRepository userRepository;

    @Test
    void healthEndpointIsPublic() throws Exception {
        mockMvc
            .perform(get("/api/health"))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.status").value("UP"));
    }

    @Test
    void studentCanRegisterAndLogin() throws Exception {
        String registration = """
            {
              "firstName": "Test",
              "lastName": "Student",
              "email": "test.student@skillforge.local",
              "password": "Student123",
              "phone": "9999999999",
              "role": "STUDENT"
            }
            """;

        mockMvc
            .perform(
                post("/api/auth/register")
                    .contentType(MediaType.APPLICATION_JSON)
                    .content(registration)
            )
            .andExpect(status().isCreated())
            .andExpect(
                jsonPath("$.email")
                    .value("test.student@skillforge.local")
            )
            .andExpect(jsonPath("$.status").value("ACTIVE"));

        String login = """
            {
              "email": "test.student@skillforge.local",
              "password": "Student123"
            }
            """;

        mockMvc
            .perform(
                post("/api/auth/login")
                    .contentType(MediaType.APPLICATION_JSON)
                    .content(login)
            )
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.token").isNotEmpty())
            .andExpect(jsonPath("$.user.role").value("STUDENT"));
    }

    @Test
    void protectedEndpointRejectsAnonymousUser()
        throws Exception {
        mockMvc
            .perform(get("/api/dashboard"))
            .andExpect(status().isUnauthorized());
    }

    @Test
    void deactivatingUserInvalidatesExistingToken()
        throws Exception {
        mockMvc
            .perform(
                post("/api/auth/register")
                    .contentType(MediaType.APPLICATION_JSON)
                    .content(
                        """
                        {
                          "firstName": "Token",
                          "lastName": "Student",
                          "email": "token.student@skillforge.local",
                          "password": "Student123",
                          "role": "STUDENT"
                        }
                        """
                    )
            )
            .andExpect(status().isCreated());

        String studentToken = login(
            "token.student@skillforge.local",
            "Student123"
        );
        String adminToken = login(
            "admin@skillforge.local",
            "Admin@123"
        );
        long studentId = userRepository
            .findByEmailIgnoreCase(
                "token.student@skillforge.local"
            )
            .orElseThrow()
            .getId();

        mockMvc
            .perform(
                patch(
                    "/api/admin/users/{id}/status",
                    studentId
                )
                    .param("status", "INACTIVE")
                    .header(
                        "Authorization",
                        bearer(adminToken)
                    )
            )
            .andExpect(status().isOk());

        mockMvc
            .perform(
                get("/api/dashboard").header(
                    "Authorization",
                    bearer(studentToken)
                )
            )
            .andExpect(status().isUnauthorized());
    }

    @Test
    void completeLearningLifecycleWorks() throws Exception {
        String adminToken = login(
            "admin@skillforge.local",
            "Admin@123"
        );

        JsonNode instructor = json(
            mockMvc
                .perform(
                    post("/api/auth/register")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(
                            """
                            {
                              "firstName": "Flow",
                              "lastName": "Instructor",
                              "email": "flow.instructor@skillforge.local",
                              "password": "Instructor123",
                              "role": "INSTRUCTOR"
                            }
                            """
                        )
                )
                .andExpect(status().isCreated())
                .andReturn()
        );

        long instructorId = instructor.get("id").asLong();

        mockMvc
            .perform(
                patch(
                    "/api/admin/users/{id}/status",
                    instructorId
                )
                    .param("status", "ACTIVE")
                    .header(
                        "Authorization",
                        bearer(adminToken)
                    )
            )
            .andExpect(status().isOk());

        JsonNode category = json(
            mockMvc
                .perform(
                    post("/api/categories")
                        .header(
                            "Authorization",
                            bearer(adminToken)
                        )
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(
                            """
                            {
                              "name": "Lifecycle Testing",
                              "description": "Integration test category"
                            }
                            """
                        )
                )
                .andExpect(status().isCreated())
                .andReturn()
        );

        String instructorToken = login(
            "flow.instructor@skillforge.local",
            "Instructor123"
        );

        JsonNode course = json(
            mockMvc
                .perform(
                    post("/api/instructor/courses")
                        .header(
                            "Authorization",
                            bearer(instructorToken)
                        )
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(
                            """
                            {
                              "title": "Lifecycle Course",
                              "description": "Course used by the end-to-end test.",
                              "price": 100,
                              "level": "BEGINNER",
                              "categoryId": %d,
                              "thumbnailUrl": ""
                            }
                            """.formatted(category.get("id").asLong())
                        )
                )
                .andExpect(status().isCreated())
                .andReturn()
        );

        long courseId = course.get("id").asLong();

        JsonNode module = json(
            mockMvc
                .perform(
                    post(
                        "/api/instructor/courses/{id}/modules",
                        courseId
                    )
                        .header(
                            "Authorization",
                            bearer(instructorToken)
                        )
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(
                            """
                            {
                              "title": "Test Module",
                              "position": 1
                            }
                            """
                        )
                )
                .andExpect(status().isCreated())
                .andReturn()
        );

        long moduleId = module.get("id").asLong();

        JsonNode lesson = json(
            mockMvc
                .perform(
                    post(
                        "/api/instructor/modules/{id}/lessons",
                        moduleId
                    )
                        .header(
                            "Authorization",
                            bearer(instructorToken)
                        )
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(
                            """
                            {
                              "title": "Test Lesson",
                              "content": "Complete this lesson.",
                              "position": 1
                            }
                            """
                        )
                )
                .andExpect(status().isCreated())
                .andReturn()
        );

        JsonNode quiz = json(
            mockMvc
                .perform(
                    post(
                        "/api/instructor/modules/{id}/quiz",
                        moduleId
                    )
                        .header(
                            "Authorization",
                            bearer(instructorToken)
                        )
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(
                            """
                            {
                              "title": "Test Quiz",
                              "passingMarks": 1,
                              "maxAttempts": 2,
                              "published": true,
                              "questions": [
                                {
                                  "text": "Which option is correct?",
                                  "marks": 1,
                                  "options": [
                                    {"text": "Correct", "correct": true},
                                    {"text": "Wrong", "correct": false}
                                  ]
                                }
                              ]
                            }
                            """
                        )
                )
                .andExpect(status().isCreated())
                .andReturn()
        );

        long quizId = quiz.get("id").asLong();
        long questionId = quiz
            .get("questions")
            .get(0)
            .get("id")
            .asLong();
        long correctOptionId = quiz
            .get("questions")
            .get(0)
            .get("options")
            .get(0)
            .get("id")
            .asLong();

        mockMvc
            .perform(
                post(
                    "/api/instructor/courses/{id}/submit",
                    courseId
                ).header(
                    "Authorization",
                    bearer(instructorToken)
                )
            )
            .andExpect(status().isOk())
            .andExpect(
                jsonPath("$.status")
                    .value("PENDING_APPROVAL")
            );

        mockMvc
            .perform(
                patch(
                    "/api/admin/courses/{id}/status",
                    courseId
                )
                    .param("status", "APPROVED")
                    .header(
                        "Authorization",
                        bearer(adminToken)
                    )
            )
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.status").value("APPROVED"));

        mockMvc
            .perform(
                post("/api/auth/register")
                    .contentType(MediaType.APPLICATION_JSON)
                    .content(
                        """
                        {
                          "firstName": "Flow",
                          "lastName": "Student",
                          "email": "flow.student@skillforge.local",
                          "password": "Student123",
                          "role": "STUDENT"
                        }
                        """
                    )
            )
            .andExpect(status().isCreated());

        String studentToken = login(
            "flow.student@skillforge.local",
            "Student123"
        );

        mockMvc
            .perform(
                post("/api/payments/checkout")
                    .header(
                        "Authorization",
                        bearer(studentToken)
                    )
                    .contentType(MediaType.APPLICATION_JSON)
                    .content(
                        """
                        {"courseId": %d}
                        """.formatted(courseId)
                    )
            )
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.status").value("SUCCESS"));

        mockMvc
            .perform(
                put(
                    "/api/learning/lessons/{id}/complete",
                    lesson.get("id").asLong()
                ).header(
                    "Authorization",
                    bearer(studentToken)
                )
            )
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.progressPercent").value(100));

        mockMvc
            .perform(
                get("/api/quizzes/module/{id}", moduleId)
                    .header(
                        "Authorization",
                        bearer(studentToken)
                    )
            )
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.id").value(quizId));

        mockMvc
            .perform(
                post("/api/quizzes/{id}/submit", quizId)
                    .header(
                        "Authorization",
                        bearer(studentToken)
                    )
                    .contentType(MediaType.APPLICATION_JSON)
                    .content(
                        """
                        {
                          "answers": {
                            "%d": %d
                          }
                        }
                        """.formatted(
                            questionId,
                            correctOptionId
                        )
                    )
            )
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.passed").value(true));

        JsonNode certificate = json(
            mockMvc
                .perform(
                    post(
                        "/api/certificates/course/{id}",
                        courseId
                    ).header(
                        "Authorization",
                        bearer(studentToken)
                    )
                )
                .andExpect(status().isOk())
                .andReturn()
        );

        String serialNumber = certificate
            .get("serialNumber")
            .asText();

        mockMvc
            .perform(
                get(
                    "/api/certificates/verify/{serial}",
                    serialNumber
                )
            )
            .andExpect(status().isOk())
            .andExpect(
                jsonPath("$.courseTitle")
                    .value("Lifecycle Course")
            );

        mockMvc
            .perform(
                get(
                    "/api/certificates/{serial}/download",
                    serialNumber
                ).header(
                    "Authorization",
                    bearer(studentToken)
                )
            )
            .andExpect(status().isOk())
            .andExpect(
                content().contentType(MediaType.APPLICATION_PDF)
            )
            .andExpect(result -> {
                String prefix = new String(
                    result
                        .getResponse()
                        .getContentAsByteArray(),
                    0,
                    4,
                    StandardCharsets.US_ASCII
                );
                org.junit.jupiter.api.Assertions.assertEquals(
                    "%PDF",
                    prefix
                );
            });
    }

    private String login(String email, String password)
        throws Exception {
        MvcResult result = mockMvc
            .perform(
                post("/api/auth/login")
                    .contentType(MediaType.APPLICATION_JSON)
                    .content(
                        """
                        {
                          "email": "%s",
                          "password": "%s"
                        }
                        """.formatted(email, password)
                    )
            )
            .andExpect(status().isOk())
            .andReturn();

        return json(result).get("token").asText();
    }

    private JsonNode json(MvcResult result) throws Exception {
        return objectMapper.readTree(
            result.getResponse().getContentAsString()
        );
    }

    private String bearer(String token) {
        return "Bearer " + token;
    }
}
