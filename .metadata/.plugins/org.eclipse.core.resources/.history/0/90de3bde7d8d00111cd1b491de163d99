package com.skillforge.backend.dto;

import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.Size;

public record ChatbotRequest(

    @NotBlank
    @Size(min = 2, max = 2000)
    String message,

    @Size(max = 200)
    String conversationId,

    @Size(max = 200)
    String courseTitle,

    @Size(max = 200)
    String lessonTitle

) {
}