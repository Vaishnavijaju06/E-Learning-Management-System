spring.application.name=skillforge-backend
server.port=${SERVER_PORT:8081}

spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/skillforgee_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:update}
spring.jpa.open-in-view=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

spring.jackson.serialization.write-dates-as-timestamps=false

app.jwt.secret=${JWT_SECRET:SkillForgeAcademicProjectJwtSecretKeyMustBeLongerThanThirtyTwoCharacters2026}
app.jwt.expiration-ms=${JWT_EXPIRATION:86400000}
app.cors.allowed-origin=${FRONTEND_URL:http://localhost:5173}
app.frontend-url=${FRONTEND_URL:http://localhost:5173}
app.seed-demo-data=${SEED_DEMO_DATA:true}
app.notifications.enabled=${NOTIFICATIONS_ENABLED:true}

app.default-admin.email=${ADMIN_EMAIL:admin@skillforge.local}
app.default-admin.password=${ADMIN_PASSWORD:Admin@123}

email.service.url=${EMAIL_SERVICE_URL:http://localhost:8082}
email.service.internal-api-key=${EMAIL_SERVICE_INTERNAL_API_KEY:skillforge-email-internal-key}

chatbot.service.url=${CHATBOT_SERVICE_URL:http://127.0.0.1:8000}
chatbot.service.internal-api-key=${CHATBOT_INTERNAL_API_KEY:skillforge-chatbot-internal-key}

management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=never

springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs
