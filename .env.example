# Docker project and host ports
COMPOSE_PROJECT_NAME=skillforge-updated
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
API_GATEWAY_PORT=8080
BACKEND_PORT=8081
EMAIL_SERVICE_PORT=8082
CHATBOT_SERVICE_PORT=8000
MYSQL_HOST_PORT=3307

# MySQL (the application uses MYSQL_USER, not root)
MYSQL_DATABASE=skillforge_db
MYSQL_USER=skillforge
MYSQL_PASSWORD=replace-this-application-database-password
MYSQL_ROOT_PASSWORD=replace-this-root-database-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Spring Boot authentication and seed account
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION=86400000
ADMIN_EMAIL=admin@skillforge.local
ADMIN_PASSWORD=replace-this-admin-password
SEED_DEMO_DATA=true
NOTIFICATIONS_ENABLED=true

# Private service-to-service keys. Use different long random values.
EMAIL_SERVICE_INTERNAL_API_KEY=replace-with-a-long-random-email-service-key
CHATBOT_INTERNAL_API_KEY=replace-with-a-long-random-chatbot-service-key

# Gmail SMTP. Keep delivery false until all SMTP values are filled.
# For Gmail, SMTP_PASSWORD must be a 16-character App Password, not
# your normal Google password. Spaces are accepted and removed by the app.
EMAIL_ENABLE_DELIVERY=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SkillForge

# Groq. With an empty key the chatbot intentionally runs in demo mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MAX_OUTPUT_TOKENS=800
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# Gateway timeouts; chatbot requests need longer than normal API calls.
UPSTREAM_TIMEOUT_MS=30000
CHATBOT_TIMEOUT_MS=90000

# Razorpay is optional unless you test real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
